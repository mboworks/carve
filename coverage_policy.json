{
  "include": ["carve/**"],
  "exclude": ["carve/*_test.cc", "carve/**/*_test.cc", "carve/third_party/**"],
  "minimum": {"lines": 60, "functions": 60, "branches": 50},
  "target": {"lines": 85, "functions": 90, "branches": 75},
  "enforce": {"lines": "medium", "functions": "medium", "branches": "medium"},
  "categories": {
    "aggregate": {"include": ["carve/aggregate/**"]},
    "aquery": {"include": ["carve/aquery/**"]},
    "cdb": {"include": ["carve/cdb/**"]},
    "cli": {"include": ["carve/cli/**"]},
    "command": {"include": ["carve/command/**"]},
    "e2e": {"include": ["carve/e2e/**"]},
    "io": {"include": ["carve/io/**"]},
    "process": {"include": ["carve/process/**"]},
    "prune": {"include": ["carve/prune/**"]},
    "refresh": {"include": ["carve/refresh/**"]},
    "scan_deps": {"include": ["carve/scan_deps/**"]},
    "shard": {"include": ["carve/shard/**"]},
    "sidecar": {"include": ["carve/sidecar/**"]}
  }
}
