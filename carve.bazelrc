# Import this file from a consumer workspace's .bazelrc. A dependency's own
# .bazelrc is not loaded by Bazel, so consumers need these Carve compile and
# link settings explicitly.

common --enable_platform_specific_config

# Carve is C++23. LLVM and Clang are consumed as prebuilt static archives.
common --cxxopt=-std=c++23 --host_cxxopt=-std=c++23

# scan_deps derives from LLVM types built without RTTI. Match the canonical
# mboworks_carve external-repository name, including Bazel's +/~ suffixes.
common --per_file_copt=mboworks_carve[^/:]*[/:]+carve[/:]+scan_deps[/:].*@-fno-rtti
common --host_per_file_copt=mboworks_carve[^/:]*[/:]+carve[/:]+scan_deps[/:].*@-fno-rtti

common --copt=-fno-exceptions

# Match carve's supported macOS floor and LLVM/Clang link requirements.
common --apple_platform_type=macos
common:macos --features=-macos_default_link_flags
common:macos --features=-supports_dynamic_linker
common:macos --linkopt=-framework --linkopt=CoreFoundation --host_linkopt=-framework --host_linkopt=CoreFoundation
common:macos --copt=-mmacosx-version-min=14.0 --host_copt=-mmacosx-version-min=14.0
common:macos --linkopt=-mmacosx-version-min=14.0 --host_linkopt=-mmacosx-version-min=14.0

# Optional supported prebuilt LLVM configuration for Carve's root module.
# Consumers build Carve with their own compatible C++ toolchain.
common:clang --incompatible_enable_cc_toolchain_resolution
common:clang --cxxopt=-gmlt --host_cxxopt=-gmlt
common:clang --linkopt=-fuse-ld=lld --host_linkopt=-fuse-ld=lld
common:clang --define=is_clang=true
common:clang --cxxopt=-Wno-unused-command-line-argument
