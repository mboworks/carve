load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

exports_files(["prebuilt.BUILD.bazel"])

# Thin Bazel wrapper over the matching official prebuilt LLVM distribution.
# The archive list is the transitive closure of clangDependencyScanning in the
# LLVM 22.1.8 ClangTargets.cmake and LLVMExports.cmake metadata.
cc_library(
    name = "clang_dependency_scanning",
    srcs = [
        "@carve_llvm_prebuilt//:lib/libLLVMAggressiveInstCombine.a",
        "@carve_llvm_prebuilt//:lib/libLLVMAnalysis.a",
        "@carve_llvm_prebuilt//:lib/libLLVMAsmParser.a",
        "@carve_llvm_prebuilt//:lib/libLLVMBinaryFormat.a",
        "@carve_llvm_prebuilt//:lib/libLLVMBitReader.a",
        "@carve_llvm_prebuilt//:lib/libLLVMBitstreamReader.a",
        "@carve_llvm_prebuilt//:lib/libLLVMCore.a",
        "@carve_llvm_prebuilt//:lib/libLLVMDebugInfoBTF.a",
        "@carve_llvm_prebuilt//:lib/libLLVMDebugInfoCodeView.a",
        "@carve_llvm_prebuilt//:lib/libLLVMDebugInfoDWARF.a",
        "@carve_llvm_prebuilt//:lib/libLLVMDebugInfoDWARFLowLevel.a",
        "@carve_llvm_prebuilt//:lib/libLLVMDebugInfoGSYM.a",
        "@carve_llvm_prebuilt//:lib/libLLVMDebugInfoMSF.a",
        "@carve_llvm_prebuilt//:lib/libLLVMDebugInfoPDB.a",
        "@carve_llvm_prebuilt//:lib/libLLVMDemangle.a",
        "@carve_llvm_prebuilt//:lib/libLLVMFrontendAtomic.a",
        "@carve_llvm_prebuilt//:lib/libLLVMFrontendDirective.a",
        "@carve_llvm_prebuilt//:lib/libLLVMFrontendHLSL.a",
        "@carve_llvm_prebuilt//:lib/libLLVMFrontendOffloading.a",
        "@carve_llvm_prebuilt//:lib/libLLVMFrontendOpenMP.a",
        "@carve_llvm_prebuilt//:lib/libLLVMIRReader.a",
        "@carve_llvm_prebuilt//:lib/libLLVMInstCombine.a",
        "@carve_llvm_prebuilt//:lib/libLLVMMC.a",
        "@carve_llvm_prebuilt//:lib/libLLVMMCParser.a",
        "@carve_llvm_prebuilt//:lib/libLLVMObject.a",
        "@carve_llvm_prebuilt//:lib/libLLVMObjectYAML.a",
        "@carve_llvm_prebuilt//:lib/libLLVMOption.a",
        "@carve_llvm_prebuilt//:lib/libLLVMPlugins.a",
        "@carve_llvm_prebuilt//:lib/libLLVMProfileData.a",
        "@carve_llvm_prebuilt//:lib/libLLVMRemarks.a",
        "@carve_llvm_prebuilt//:lib/libLLVMScalarOpts.a",
        "@carve_llvm_prebuilt//:lib/libLLVMSupport.a",
        "@carve_llvm_prebuilt//:lib/libLLVMSymbolize.a",
        "@carve_llvm_prebuilt//:lib/libLLVMTargetParser.a",
        "@carve_llvm_prebuilt//:lib/libLLVMTextAPI.a",
        "@carve_llvm_prebuilt//:lib/libLLVMTransformUtils.a",
        "@carve_llvm_prebuilt//:lib/libLLVMWindowsDriver.a",
        "@carve_llvm_prebuilt//:lib/libclangAPINotes.a",
        "@carve_llvm_prebuilt//:lib/libclangAST.a",
        "@carve_llvm_prebuilt//:lib/libclangASTMatchers.a",
        "@carve_llvm_prebuilt//:lib/libclangAnalysis.a",
        "@carve_llvm_prebuilt//:lib/libclangAnalysisLifetimeSafety.a",
        "@carve_llvm_prebuilt//:lib/libclangBasic.a",
