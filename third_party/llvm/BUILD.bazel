        "@carve_llvm_prebuilt//:lib/libclangOptions.a",
        "@carve_llvm_prebuilt//:lib/libclangParse.a",
        "@carve_llvm_prebuilt//:lib/libclangRewrite.a",
        "@carve_llvm_prebuilt//:lib/libclangSema.a",
        "@carve_llvm_prebuilt//:lib/libclangSerialization.a",
        "@carve_llvm_prebuilt//:lib/libclangSupport.a",
        "@carve_llvm_prebuilt//:lib/libclangTooling.a",
        "@carve_llvm_prebuilt//:lib/libclangToolingCore.a",
        "@carve_llvm_prebuilt//:lib/libclangToolingInclusions.a",
    ],
    features = [
        "-layering_check",
        "-parse_headers",
    ],
    linkopts = select({
