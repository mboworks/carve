            "-lcurses",
            "-lm",
            "-lxml2",
            "-lz",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//carve/scan_deps:__pkg__"],
    deps = [
        "@carve_llvm_prebuilt//:clang_headers",
        "@zstd",
    ],
)
