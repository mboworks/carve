"""Module mboworks_carve.

Carve compile_commands.json out of Bazel build graphs for clangd-style tooling.
See CARVE_DESIGN.md for the architecture.
"""

module(
    name = "mboworks_carve",
    version = "0.1.0",
)

# Development-only modules: the Hedron compile-commands extractor (helly25 fork)
# for clangd + local clang-tidy, and dwyu. All dev_dependency, so they are used
# only when carve is the root module and never propagate to dependents. See
# STYLE_CPP.md ("Toolchain") for how clang-tidy is run locally.
include("//bazelmod:dev.MODULE.bazel")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "protobuf", version = "36.0.bcr.1")
bazel_dep(name = "mboworks_mbo", version = "0.14.0")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")

# Test-only deps.
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

# Proto test matchers (EqualsProto/Partially/WhenDeserialized) that upstream
# protobuf does not ship. Used to assert on proto data structurally instead of
# comparing serialized strings. See CARVE_DESIGN.md section 9.1.
bazel_dep(name = "helly25_proto", version = "1.2.1", dev_dependency = True)

# Root-development C++ toolchain from bazel-contrib/toolchains_llvm. This is a
# dev dependency because downstream modules compile Carve with their own
# ABI-compatible toolchain.
bazel_dep(name = "toolchains_llvm", version = "1.9.0", dev_dependency = True)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    name = "llvm_toolchain",
    # MSan reports false positives for reads from an uninstrumented standard
    # library. toolchains_llvm's msan feature swaps this matching overlay in on
    # Linux; ordinary builds continue to use the stdlib selection below.
    libcxx_sha256 = "fd1ac49eeda4edc6deeda2037998e558718a63a5054fff4fdace7751b270217a",
    libcxx_url = "https://github.com/RealtimeRoboticsGroup/toolchains/releases/download/22.1.8/libcxx-msan-22.1.8-x86_64-linux-gnu-ubuntu-22.04.tar.zst",
    llvm_version = "22.1.8",
    # Match the standard library used to build the official static archives.
    # The unqualified stdc++ selection links it statically.
    stdlib = {
        "": "builtin-libc++",
        "linux-aarch64": "stdc++",
        "linux-x86_64": "stdc++",
    },
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

# Static Clang/LLVM development libraries are needed by Carve as both a root
# module and a dependency. Keep their repository independent from the root-only
# toolchains_llvm configuration above.
llvm_prebuilt = use_extension("//bazelmod:llvm_prebuilt.bzl", "llvm_prebuilt")
use_repo(llvm_prebuilt, "carve_llvm_prebuilt")
